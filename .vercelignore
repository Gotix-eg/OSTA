# Ignore node_modules recursively
node_modules
**/node_modules

# Ignore Next.js cache and dev builds
.next
**/.next
.next-dev
**/.next-dev
.turbo
**/.turbo

# Ignore mobile application (only web & server are needed)
apps/mobile
**/android
**/ios

# Ignore environment files
.env
.env.local
**/.env
**/.env.local

# Ignore logs and tests
*.log
coverage
**/.vercel

# Ignore large binary files and app bundles
*.aab
*.apk
*.zip
*.tar.gz
